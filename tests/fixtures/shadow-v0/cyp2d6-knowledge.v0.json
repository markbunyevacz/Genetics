  "inventory": {
    "van": [
      {
        "id": "FDA-DDI-TABLE-2-2",
        "hu": "VAN: az FDA 2-2. táblája a paroxetint (WHO ATC N06AB05, 7 karakter) és a fluoxetint (N06AB03) erős CYP2D6-gátlónak minősíti. Azt NEM mondja, hogy ettől a beteg szegény metabolizáló."
      },
      {
        "id": "CPIC-SSRI-2023-TABLE-2A",
        "hu": "VAN: a CPIC SSRI 2023 2a táblája a paroxetin adagolási stratégiáját a gén szerinti osztályhoz köti (normál metabolizáló: CONTINUE). A fluoxetinre nincs gén-alapú adagolás (CPIC C)."
      },
      {
        "id": "CPIC-OPIOID-2020",
        "hu": "VAN: a CPIC opioid 2020 guideline-ban erős CYP2D6-gátló mellett az aktivitási pont 0, a jósolt fenotípus szegény metabolizáló. Ez opioid szubsztrátra (kodein stb.) vonatkozik, nem a paroxetin-SSRI sorra."
      },
      {
        "id": "WHO-ATC",
        "hu": "VAN: a WHO ATC 5. szint (7 karakter) a hatóanyag: N06AB05 = paroxetin, N06AB03 = fluoxetin, B01AC04 = clopidogrel. Az N06AB (5 karakter) a teljes SSRI-csoport, benne pl. az eszcitaloprám is, ami nem erős CYP2D6-gátló."
      },
      {
        "id": "CPIC-CYP2C19-CLOPIDOGREL",
        "hu": "VAN: a CPIC CYP2C19–clopidogrel guideline (ClinPGx PA166251443) stratégia-kategóriája a gén szerinti osztályhoz kötött. A live finding nem tartalmaz milligrammot, és nem keveri a CPIC sort DPWG/FDA szöveggel."
      },
      {
        "id": "CPIC-PREPARE12-LIVE-PAIRS",
        "hu": "VAN: PREPARE-12 élő párosítás a pinelt CPIC recommendation_view stratégia-kategóriájából (CYP2B6–efavirenz, CYP2C9–celecoxib, CYP3A5–tacrolimus, DPYD–fluorouracil, SLCO1B1–simvastatin, TPMT–azathioprine, HLA-B–abacavir, UGT1A1–atazanavir, plusz a korábbi CYP2D6-SSRI és CYP2C19–clopidogrel). Nincs milligramm a live findingben."
      }
    ],
    "hianyzik": [
      {
        "id": "CPIC-SSRI-NM-TO-PM",
        "hu": "NINCS: a CPIC SSRI 2023-ban nincs olyan sor, amely a gén szerinti normál metabolizálót gátló mellett szegény metabolizálóvá írná át. A guideline szövege: a gátló melletti fenotípus-állításra nincs konszenzus."
      },
      {
        "id": "FDA-NM-TO-PM",
        "hu": "NINCS: az FDA gátló-listája nem tartalmaz NM→szegény metabolizáló leképezést."
      },
      {
        "id": "CPIC-F5-VKORC1-REC",
        "hu": "NINCS: a CPIC recommendation_view F5-re és VKORC1-re üres. Élő párosítás ezekre nincs kitalálva."
      }
    ],
    "beszerzes": {
      "kinek": "A gyártó (ez a repo / engineering) tölti le és pin-eli. Nem a labor és nem a kórház.",
      "kitol": "CPIC (files.cpicpgx.org PDF + api.cpicpgx.org), FDA DDI Table 2-2, WHOCC ATC index, ClinPGx DPWG guidelineAnnotation.",
      "hogyan": "Nyilvános URL, accessed dátum, és a letöltött fájl a docs/pce/Sources/official/ mappában. Script: docs/pce/Sources/official/fetch_official_sources.py és tests/fixtures/f1plus-v0/extract_cpic_prepare12_tables.py. A motor a pin-elt JSON extractet olvassa, nem a PDF-et futáskor.",
      "mikorra": "A 2020-as opioid és a 2023-as SSRI guideline, plusz az FDA lista, 2026-08-13-án megvan. SSRI NM→szegény sor: akkor, amikor a CPIC vagy az FDA ilyet kiad — addig szegény metabolizálót funkcionális címkeként írni tilos, a hiányt jelezni kell."
    }
  },
  "strategy_labels_hu": {
    "CONTINUE": "A CPIC 2a tábla szerint a gén szerinti normál metabolizáló kategóriában a paroxetin folytatható (nem betegre számolt milligramm).",
    "CONSIDER_DOSE_CHANGE": "A CPIC 2a tábla szerint a gén szerinti osztályban dózisváltoztatás megfontolandó (nem számolt mg).",
    "CONSIDER_ALTERNATIVE": "A CPIC 2a tábla szerint más szer megfontolandó.",
    "NO_GENE_BASED_DOSING": "A CPIC szerint erre a szerre nincs gén-alapú adagolás (fluoxetin: CPIC C).",
    "INSUFFICIENT_RESOLUTION": "Csak csoportkód jött (5 karakter, pl. N06AB = SSRI-csoport). A párosításhoz hatóanyag-kód kell (7 karakter, WHO ATC 5. szint). Nem azért, mert egy szer egy beteget azonosítana: ugyanazt a hatóanyagot sok beteg szedheti. Az N06AB csoportban több hatóanyag van (paroxetin, fluoxetin, eszcitaloprám); az eszcitaloprám nem erős CYP2D6-gátló. A default export 7 karakteres kódot tart. Ha a DPO durvít csoportkódra, a párosítás szünetel."
  },
